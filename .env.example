# Public URL of the deployed app. Used for absolute links in share previews
# (WhatsApp, Facebook). Optional on Vercel, which provides its own domain;
# locally it defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://nodo.example

# Supabase project. The app ships with NODO's URL and publishable key (both
# public by design; row level security protects the data). Override them to
# point a branch at another project. Never put the secret/service_role key here.
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# "demo": example content only, never touches the database (CI and e2e use it).
# NODO_MODE=demo

# "off": hide the example content shown next to real listings.
# NODO_EXAMPLE_CONTENT=off
